# Atrinik Windows LLVM producer; Copyright 2026 The Atrinik Project.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(ATRINIK_WINDOWS_TARGET x86_64-w64-mingw32)
set(ATRINIK_WINDOWS_PREFIX /opt/atrinik-windows)
set(ATRINIK_LLVM_MINGW /opt/llvm-mingw)
set(CMAKE_C_COMPILER "${ATRINIK_LLVM_MINGW}/bin/${ATRINIK_WINDOWS_TARGET}-clang")
set(CMAKE_CXX_COMPILER "${ATRINIK_LLVM_MINGW}/bin/${ATRINIK_WINDOWS_TARGET}-clang++")
set(CMAKE_AR "${ATRINIK_LLVM_MINGW}/bin/llvm-ar")
set(CMAKE_RANLIB "${ATRINIK_LLVM_MINGW}/bin/llvm-ranlib")
set(CMAKE_RC_COMPILER "${ATRINIK_LLVM_MINGW}/bin/${ATRINIK_WINDOWS_TARGET}-windres")
set(CMAKE_LINKER "${ATRINIK_LLVM_MINGW}/bin/ld.lld")
set(CMAKE_NM "${ATRINIK_LLVM_MINGW}/bin/llvm-nm")
set(CMAKE_OBJCOPY "${ATRINIK_LLVM_MINGW}/bin/llvm-objcopy")
set(CMAKE_OBJDUMP "${ATRINIK_LLVM_MINGW}/bin/llvm-objdump")
set(CMAKE_READELF "${ATRINIK_LLVM_MINGW}/bin/llvm-readelf")
set(CMAKE_STRIP "${ATRINIK_LLVM_MINGW}/bin/llvm-strip")
set(CMAKE_DLLTOOL "${ATRINIK_LLVM_MINGW}/bin/llvm-dlltool")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-rtlib=compiler-rt -fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-rtlib=compiler-rt -fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-rtlib=compiler-rt -fuse-ld=lld")
set(CMAKE_C_COMPILER_LAUNCHER ccache)
set(CMAKE_CXX_COMPILER_LAUNCHER ccache)
set(CMAKE_INSTALL_PREFIX "${ATRINIK_WINDOWS_PREFIX}" CACHE PATH "Target installation prefix")
set(CMAKE_PREFIX_PATH "${ATRINIK_WINDOWS_PREFIX}")
set(CMAKE_FIND_ROOT_PATH "${ATRINIK_WINDOWS_PREFIX}" "${ATRINIK_LLVM_MINGW}/${ATRINIK_WINDOWS_TARGET}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(PKG_CONFIG_EXECUTABLE "${ATRINIK_WINDOWS_PREFIX}/bin/${ATRINIK_WINDOWS_TARGET}-pkg-config" CACHE FILEPATH "Target pkg-config")
