{
  "name": "Atrinik Windows cross-build (MXE)",
  "image": "ghcr.io/atrinik/windows-build:0.0.3",
  "workspaceFolder": "/workspaces/atrinik",
  "remoteUser": "vscode",
  "initializeCommand": "if [ ! -e \"${localEnv:HOME}/.gitconfig\" ]; then install -m 600 /dev/null \"${localEnv:HOME}/.gitconfig\"; fi",
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly"
  ],
  "remoteEnv": {
    "PATH": "/opt/mxe/usr/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "git submodule update --init --recursive || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "cmake.cmakePath": "/opt/mxe/usr/bin/x86_64-w64-mingw32.shared-cmake",
        "cmake.configureArgs": [
          "--no-warn-unused-cli"
        ],
        "cmake.configurePreset": "windows-mxe-release",
        "cmake.buildPreset": "windows-mxe-release"
      }
    }
  }
}
